<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/margin_medium"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/knowledge_card_gradient">

        <!-- 知识配图 (Knowledge Image) -->
        <ImageView
            android:id="@+id/ivKnowledgeImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_modern"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.4"
            android:contentDescription="知识配图" />

        <!-- 渐变遮罩 (Gradient Overlay) -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/image_overlay_gradient"
            app:layout_constraintTop_toTopOf="@id/ivKnowledgeImage"
            app:layout_constraintBottom_toBottomOf="@id/ivKnowledgeImage"
            app:layout_constraintStart_toStartOf="@id/ivKnowledgeImage"
            app:layout_constraintEnd_toEndOf="@id/ivKnowledgeImage" />

        <!-- 分类标签 (Category Tag) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="基础概念"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="@color/primary_blue"
            app:chipCornerRadius="16dp"
            app:layout_constraintTop_toTopOf="@id/ivKnowledgeImage"
            app:layout_constraintEnd_toEndOf="@id/ivKnowledgeImage"
            android:layout_margin="@dimen/margin_medium" />

        <!-- 内容区域 (Content Area) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:padding="@dimen/margin_large"
            app:layout_constraintTop_toBottomOf="@id/ivKnowledgeImage"
            app:layout_constraintBottom_toTopOf="@id/layoutFooter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 标题 (Title) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="面向对象编程基础"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 描述内容 (Description Content) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fadeScrollbars="true">

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="面向对象编程（Object-Oriented Programming，OOP）是一种编程范式，它使用对象来设计应用程序和计算机程序。这种编程方法基于几个核心概念：封装、继承、多态和抽象。通过这些概念，开发者可以创建更加模块化、可重用和易于维护的代码..."
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="4dp"
                    android:justificationMode="inter_word" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- 底部信息栏 (Footer Information) -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_large"
            android:gravity="center_vertical"
            android:background="@drawable/footer_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 更新时间 (Update Time) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="更新时间" />

                <TextView
                    android:id="@+id/tvUpdateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-01-15"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- 收藏按钮 (Favorite Button) -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_favorite_border"
                android:background="@drawable/button_circle_transparent"
                android:contentDescription="收藏" />

            <!-- 分享按钮 (Share Button) -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_share"
                android:background="@drawable/button_circle_transparent"
                android:layout_marginStart="8dp"
                android:contentDescription="分享" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

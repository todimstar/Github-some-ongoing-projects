<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/margin_medium"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/knowledge_card_gradient">

        <!-- 知识配图 (Knowledge Image) -->
        <ImageView
            android:id="@+id/ivKnowledgeImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="@drawable/image_placeholder_modern"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.35"
            android:contentDescription="知识配图" />

        <!-- 渐变遮罩 (Gradient Overlay) -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/image_overlay_gradient"
            app:layout_constraintTop_toTopOf="@id/ivKnowledgeImage"
            app:layout_constraintBottom_toBottomOf="@id/ivKnowledgeImage"
            app:layout_constraintStart_toStartOf="@id/ivKnowledgeImage"
            app:layout_constraintEnd_toEndOf="@id/ivKnowledgeImage" />

        <!-- 分类标签 (Category Tag) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="基础概念"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="@color/primary_blue"
            app:chipCornerRadius="16dp"
            app:layout_constraintTop_toTopOf="@id/ivKnowledgeImage"
            app:layout_constraintEnd_toEndOf="@id/ivKnowledgeImage"
            android:layout_margin="@dimen/margin_medium" />

        <!-- 内容区域 (Content Area) -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:padding="@dimen/margin_large"
            app:layout_constraintTop_toBottomOf="@id/ivKnowledgeImage"
            app:layout_constraintBottom_toTopOf="@id/layoutFooter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 标题 (Title) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="面向对象编程基础"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/margin_medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 描述内容 (Description Content) -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:fadeScrollbars="true"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="面向对象编程（Object-Oriented Programming，OOP）是一种编程范式，它使用对象来设计应用程序和计算机程序。这种编程方法基于几个核心概念：封装、继承、多态和抽象。通过这些概念，开发者可以创建更加模块化、可重用和易于维护的代码。\n\n封装是将数据和操作数据的方法组合在一起的过程，隐藏内部实现细节。继承允许新类基于现有类创建，继承其属性和方法。多态使得同一个接口可以用于不同的底层形式。抽象则是隐藏复杂实现细节，只暴露必要的功能。"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:justificationMode="inter_word" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- 底部信息栏 (Footer Information) - 确保有足够空间显示 -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/margin_large"
            android:gravity="center_vertical"
            android:background="@drawable/footer_background"
            android:minHeight="72dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 左侧信息区域 (Left Info Area) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 更新时间 (Update Time) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_clock"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="更新时间" />

                    <TextView
                        android:id="@+id/tvUpdateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024-01-15"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- 阅读时长 (Reading Time) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_timer"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="阅读时长" />

                    <TextView
                        android:id="@+id/tvReadingTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="约5分钟"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- 右侧操作按钮区域 (Right Action Area) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 收藏按钮 (Favorite Button) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_favorite_border"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/accent_orange"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/accent_orange"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    android:contentDescription="收藏"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <!-- 分享按钮 (Share Button) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@android:color/white"
                    style="@style/Widget.Material3.Button"
                    android:backgroundTint="@color/secondary_green"
                    app:cornerRadius="24dp"
                    android:contentDescription="分享"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
